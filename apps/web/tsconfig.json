{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "DOM.AsyncIterable", "WebWorker.ImportScripts"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "useDefineForClassFields": true,
    "noEmit": true,
    "jsx": "preserve",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "paths": {
      "#build/ui/*": ["./node_modules/.nuxt-ui/ui/*"],
      "@livesaver/xml": ["../../packages/xml/src/index.ts"],
      "@livesaver/core": ["../../packages/core/src/index.ts"],
      "@livesaver/plugins": ["../../packages/plugins/src/index.ts"],
      "@livesaver/ops": ["../../packages/ops/src/index.ts"],
      "@livesaver/web": ["../../packages/web/src/index.ts"],
      "livesaver": ["../../packages/cli/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "auto-imports.d.ts", "components.d.ts"]
}
