{
  "name": "livesaver-web",
  "version": "0.0.0",
  "private": true,
  "description": "livesaver's web app: scan Ableton Live projects for missing samples and plug-in problems; with livesaver on the same computer, fix them.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "bun dev.ts",
    "build": "bunx --bun vite build",
    "typecheck": "tsc -p tsconfig.logic.json && bun ../../scripts/vue-typecheck.ts",
    "test:e2e": "bun test ./e2e/*.e2e.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@iconify-json/lucide": "^1.2.139",
    "@livesaver/core": "workspace:*",
    "@livesaver/ops": "workspace:*",
    "@livesaver/web": "workspace:*",
    "@nuxt/ui": "^4.11.3",
    "@vueuse/core": "^14.4.0",
    "pinia": "^4.0.3",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@livesaver/test-kit": "workspace:*",
    "@vitejs/plugin-vue": "^6.0.9",
    "livesaver": "workspace:*",
    "playwright": "1.63.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.2",
    "vue-tsc": "^3.3.12"
  }
}
