{
  "name": "livesaver",
  "version": "0.0.0",
  "description": "Keep your Ableton Live projects alive: relink missing samples, batch Collect All and Save, upgrade VST2 to VST3, audit plug-ins.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": "Manuel Haller Polo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Polobase/livesaver.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/Polobase/livesaver/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/Polobase/livesaver/issues"
  },
  "engines": {
    "node": ">=22.13"
  },
  "files": [
    "dist",
    "src"
  ],
  "bin": {
    "livesaver": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.build.json --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@livesaver/catalog": "workspace:*",
    "@livesaver/core": "workspace:*",
    "@livesaver/node": "workspace:*",
    "@livesaver/ops": "workspace:*",
    "@livesaver/plugins": "workspace:*",
    "@livesaver/xml": "workspace:*",
    "commander": "15.0.0",
    "picocolors": "1.1.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ableton",
    "ableton-live",
    "cli",
    "collect-all-and-save",
    "missing-samples",
    "vst3",
    "relink"
  ]
}
