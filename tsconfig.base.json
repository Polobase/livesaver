{
  "compilerOptions": {
    "strict": true,
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "paths": {
      "@livesaver/xml": ["./packages/xml/src/index.ts"],
      "@livesaver/core": ["./packages/core/src/index.ts"],
      "@livesaver/node": ["./packages/node/src/index.ts"],
      "@livesaver/ops": ["./packages/ops/src/index.ts"],
      "@livesaver/test-kit": ["./packages/test-kit/src/index.ts"],
      "livesaver": ["./packages/cli/src/index.ts"],
      "@livesaver/plugins": ["./packages/plugins/src/index.ts"],
      "@livesaver/catalog": ["./packages/catalog/src/index.ts"],
      "@livesaver/web": ["./packages/web/src/index.ts"]
    }
  }
}
